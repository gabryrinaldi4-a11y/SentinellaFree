<Window x:Class="Sentinella.Desktop.AppControlWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Sentinella · Controllo applicazioni" Width="1120" Height="880" MinWidth="920" MinHeight="680" WindowStartupLocation="CenterOwner" Background="#F4F6FB">
<ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="28">
<Border Background="#142C52" CornerRadius="18" Padding="26" Margin="0,0,0,18"><StackPanel><TextBlock Text="CONTROLLO APPLICAZIONI" Foreground="#9BC5FF" FontSize="11" FontWeight="SemiBold"/><TextBlock Text="Decidi quali versioni autorizzare" FontSize="27" FontWeight="SemiBold" Foreground="White" Margin="0,9,0,8"/><TextBlock Text="Regole AppLocker di Windows per gli eseguibili del tuo utente. Audit prima, blocco solo dopo la tua conferma." Foreground="#B5CCEA" LineHeight="22"/></StackPanel></Border>
<Border Style="{StaticResource Card}" Margin="0,0,0,16"><StackPanel><Grid><TextBlock x:Name="PolicyStatus" Text="Stato non ancora letto" FontSize="19" FontWeight="SemiBold"/><Button Content="Aggiorna stato" Click="RefreshStatus" HorizontalAlignment="Right" Style="{StaticResource Secondary}"/></Grid><TextBlock x:Name="StatusDetails" Text="Nessuna attivazione automatica." Style="{StaticResource Body}" Margin="0,12,0,0"/><TextBlock x:Name="SacDetails" Style="{StaticResource Body}" Margin="0,8,0,0"/></StackPanel></Border>
<Border Style="{StaticResource Card}" Margin="0,0,0,16"><StackPanel><TextBlock Text="La tua lista di autorizzazioni" Style="{StaticResource SectionTitle}"/><TextBlock Text="Scegli solo file che riconosci. L'autorizzazione identifica una versione precisa, non certifica che sia sicura. Le modifiche alla lista restano una bozza fino all'applicazione con UAC." Style="{StaticResource Body}" Margin="0,0,0,12"/><WrapPanel><Button Content="Aggiungi eseguibile…" Click="AddApplication" Margin="0,0,8,8"/><Button Content="Aggiungi Sentinella e motore" Click="AddEssentials" Style="{StaticResource Secondary}" Margin="0,0,8,8"/><Button Content="Rimuovi dalla bozza" Click="RemoveApplication" Style="{StaticResource Outline}" Margin="0,0,0,8"/></WrapPanel>
<DataGrid x:Name="ApprovalGrid" Height="205" ItemsSource="{Binding Approvals}" Margin="0,8,0,0"><DataGrid.Columns><DataGridTextColumn Header="APPLICAZIONE" Binding="{Binding Name}" Width="150"/><DataGridTextColumn Header="FILE" Binding="{Binding Path}" Width="*"/><DataGridTextColumn Header="SHA256 DEL FILE" Binding="{Binding Sha256}" Width="200"/></DataGrid.Columns></DataGrid><TextBlock x:Name="DraftStatus" Style="{StaticResource Body}" Margin="0,10,0,0"/></StackPanel></Border>
<Border Style="{StaticResource Card}" Margin="0,0,0,16"><StackPanel><TextBlock Text="Verifica prima di applicare" Style="{StaticResource SectionTitle}"/><TextBlock Text="Il test usa il motore AppLocker senza avviare il file e senza installare criteri. Il risultato riguarda solo queste regole: Smart App Control e gli altri antivirus decidono separatamente." Style="{StaticResource Body}"/><WrapPanel Margin="0,14,0,0"><Button Content="Verifica un file…" Click="TestApplication" Style="{StaticResource Secondary}" Margin="0,0,8,8"/><Button Content="Esporta piano e regole…" Click="ExportPlan" Style="{StaticResource Outline}" Margin="0,0,0,8"/></WrapPanel><TextBox x:Name="TestResult" IsReadOnly="True" TextWrapping="Wrap" MinHeight="65" MaxHeight="170" VerticalScrollBarVisibility="Auto"/></StackPanel></Border>
<Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Applica al sistema" Style="{StaticResource SectionTitle}"/><TextBlock Text="Prima versione: EXE/COM del solo utente selezionato. Windows costituisce la base autorizzata; Program Files e opzionale; alcune cartelle Windows scrivibili sono escluse. Le app pacchettizzate firmate restano consentite. Script, DLL, macro e abuso di programmi gia autorizzati non sono coperti. Non equivale a Smart App Control." Style="{StaticResource Body}"/><TextBlock Text="Non vengono sostituiti criteri AppLocker gia presenti o gestiti dall'organizzazione. Il backup di ripristino viene protetto in ProgramData. Audit non blocca le app; passare da blocco ad audit riduce questa specifica protezione." Style="{StaticResource Body}" Margin="0,8,0,0"/>
<CheckBox x:Name="AllowPrograms" Checked="BaselineChanged" Unchecked="BaselineChanged" Content="Consenti anche tutti gli eseguibili in Program Files (profilo meno restrittivo)."/>
<CheckBox x:Name="AuditReviewed" Content="Ho esaminato l'audit e verificato le applicazioni necessarie prima del blocco."/>
<WrapPanel><Button Content="1 · Applica audit" Tag="Audit" Click="ChangePolicy" Style="{StaticResource Secondary}" Margin="0,0,8,8"/><Button Content="2 · Attiva blocco" Tag="Enforce" Click="ChangePolicy" Margin="0,0,8,8"/><Button Content="Ripristina criterio precedente" Tag="Restore" Click="ChangePolicy" Style="{StaticResource Outline}" Margin="0,0,0,8"/><Button Content="Apri eventi AppLocker" Click="OpenEvents" Style="{StaticResource Secondary}" Margin="0,0,0,8"/></WrapPanel>
<TextBlock x:Name="ActionResult" Text="Nessuna modifica richiesta." Style="{StaticResource Body}" Margin="0,10,0,0"/></StackPanel></Border>
</StackPanel></ScrollViewer></Window>
