<Window x:Class="Sentinella.Desktop.ContinuousWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Sentinella · Protezione continua" Width="1120" Height="880" MinWidth="920" MinHeight="680" WindowStartupLocation="CenterOwner" Background="#F4F6FB">
<ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="28">
<Border Background="#142C52" CornerRadius="18" Padding="26" Margin="0,0,0,18"><StackPanel><TextBlock Text="CONTROLLI CONTINUI · SVILUPPO 0.4" Foreground="#9BC5FF" FontSize="11"/><TextBlock Text="Un agente, uno stato verificabile" FontSize="27" Foreground="White" FontWeight="SemiBold" Margin="0,9,0,8"/><TextBlock Text="Scansioni dopo le modifiche, avvisi comportamentali e firme aggiornabili. Non sostituisce la protezione preventiva dell'antivirus attuale." Foreground="#B5CCEA"/></StackPanel></Border>
<Border Style="{StaticResource Card}" Margin="0,0,0,16"><StackPanel><TextBlock x:Name="AgentStatus" Text="Agente non ancora letto" Style="{StaticResource SectionTitle}"/><TextBlock x:Name="AgentDetails" Style="{StaticResource Body}"/><TextBlock x:Name="WindowsDetails" Text="Protezione preventiva: verifica il provider Windows, separato dal monitor ClamAV." Style="{StaticResource Body}" Margin="0,8,0,0"/><Button Content="Leggi protezioni Windows" Click="ReadWindows" Style="{StaticResource Secondary}" HorizontalAlignment="Left" Margin="0,12,0,0"/></StackPanel></Border>
<Border Style="{StaticResource Card}" Margin="0,0,0,16"><StackPanel><TextBlock Text="Cartelle e avvio del monitor" Style="{StaticResource SectionTitle}"/><TextBlock Text="L'agente resta in esecuzione dopo la chiusura della finestra. Parte dopo il tuo accesso a Windows se lo richiedi. Non e un servizio di sistema protetto; un programma dello stesso utente puo fermarlo. I file gia presenti richiedono una scansione manuale iniziale." Style="{StaticResource Body}"/><ListBox x:Name="FolderList" Height="100" Margin="0,12,0,10"/><WrapPanel><Button Content="Aggiungi cartella" Click="AddFolder" Style="{StaticResource Secondary}" Margin="0,0,8,0"/><Button Content="Rimuovi" Click="RemoveFolder" Style="{StaticResource Outline}"/></WrapPanel><CheckBox x:Name="AutoDefinitions" Content="Aggiorna automaticamente le firme ufficiali ClamAV ogni 6 ore (connessione ai mirror)."/><CheckBox x:Name="ObserveProcesses" Content="Osserva i processi ogni 20 secondi e segnala alcune combinazioni sospette, senza bloccarli."/><CheckBox x:Name="StartAtLogon" Content="Avvia questo agente al mio accesso a Windows (impostazione del solo utente)."/><WrapPanel><Button Content="Avvia agente" Click="StartAgent" Margin="0,0,8,0"/><Button Content="Ferma agente" Click="StopAgent" Style="{StaticResource Secondary}"/></WrapPanel></StackPanel></Border>
<Border Style="{StaticResource Card}" Margin="0,0,0,16"><StackPanel><TextBlock Text="Rilevamenti e segnali da esaminare" Style="{StaticResource SectionTitle}"/><TextBlock Text="Warning significa segnale o limite, Detection significa rilevamento ClamAV. Nessuna cancellazione, quarantena o terminazione automatica. Non e un rilevatore completo di ransomware o attacchi sconosciuti." Style="{StaticResource Body}"/><DataGrid x:Name="AlertGrid" Height="220" Margin="0,12,0,0"><DataGrid.Columns><DataGridTextColumn Header="TIPO" Binding="{Binding Severity}" Width="100"/><DataGridTextColumn Header="OGGETTO" Binding="{Binding Subject}" Width="230"/><DataGridTextColumn Header="DETTAGLIO" Binding="{Binding Detail}" Width="*" MinWidth="150"/></DataGrid.Columns></DataGrid><Button Content="Porta il file in Scansioni" Click="GoToScan" Style="{StaticResource Secondary}" HorizontalAlignment="Left" Margin="0,12,0,0"/></StackPanel></Border>
<Border Style="{StaticResource Card}" Margin="0,0,0,16"><StackPanel><TextBlock Text="Filtro web per Chrome, Edge e Brave" Style="{StaticResource SectionTitle}"/><TextBlock Text="Estensione separata Manifest V3: blocchi per dominio, eccezioni personali e aggiornamento facoltativo della lista CERT Polska. Non legge il contenuto delle pagine e non invia la cronologia. Deve essere installata e autorizzata dal titolare nel browser; ora non e attivata da Sentinella." Style="{StaticResource Body}"/><WrapPanel Margin="0,12,0,0"><Button Content="Apri cartella estensione" Click="OpenExtension" Style="{StaticResource Secondary}" Margin="0,0,8,0"/><Button Content="Istruzioni installazione" Click="ExtensionHelp" Style="{StaticResource Outline}"/></WrapPanel></StackPanel></Border>
<Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Integrita e aggiornamenti del programma" Style="{StaticResource SectionTitle}"/><TextBlock Text="Controllo hash dei componenti e verificatore di manifesti di rilascio firmati RSA-PSS. Nessuna chiave di rilascio pubblicata e fissata in questa build: installazione automatica degli aggiornamenti del programma disabilitata. Le firme ClamAV hanno il loro aggiornamento autenticato separato." Style="{StaticResource Body}"/><Button Content="Controlla integrita locale" Click="CheckIntegrity" Style="{StaticResource Secondary}" HorizontalAlignment="Left" Margin="0,12,0,0"/><TextBlock x:Name="IntegrityResult" Style="{StaticResource Body}" Margin="0,10,0,0"/></StackPanel></Border>
<TextBlock x:Name="OperationResult" Text="Nessuna nuova protezione o regola attivata automaticamente." Style="{StaticResource Body}" Margin="0,20,0,0"/>
</StackPanel></ScrollViewer></Window>
